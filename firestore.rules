rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'opaidamazed@gmail.com',
        'obaidamazed@gmail.com',
        '016nooralhuda@gmail.com',
        '01019771940@alhuda-ar.app',
        '01223093974@alhuda-ar.app'
      ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      // التسجيل: لازم قيد المراجعة، من غير رصيد ولا كورسات مشتراة
      allow create: if isOwner(uid)
                    && request.resource.data.status == 'pending'
                    && (!('balance' in request.resource.data)
                        || request.resource.data.balance == 0)
                    && !('purchased' in request.resource.data)
                    && !('lastPurchase' in request.resource.data);

      allow update: if isAdmin()
                    || (isOwner(uid) && (profileEdit() || coursePurchase()));

      allow delete: if isAdmin();

      // الطالب يعدّل بياناته العادية بس (مش الحالة ولا الرصيد ولا الكورسات)
      function profileEdit() {
        return !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['status', 'balance', 'purchased', 'lastPurchase']);
      }

      // شراء كورس: خصم السعر الحقيقي (من site/prices) + تسجيل كورس واحد جديد
      function coursePurchase() {
        let d = request.resource.data;
        let old = resource.data;
        let cid = d.lastPurchase;
        let oldPurchased = old.get('purchased', {});
        let price = get(/databases/$(database)/documents/site/prices).data[cid];
        return d.diff(old).affectedKeys().hasOnly(['balance', 'purchased', 'lastPurchase'])
            && old.status == 'active'
            && cid is string
            && price is number
            && price > 0
            && !(cid in oldPurchased)
            && d.purchased.diff(oldPurchased).affectedKeys().hasOnly([cid])
            && d.purchased[cid].price == price
            && d.balance >= 0
            && math.abs(d.balance - (old.get('balance', 0) - price)) < 0.005;
      }
    }

    // محتوى الكورسات المدفوعة (فيديوهات وملفات): للأدمن أو للطالب المشترك في الكورس بس
    function ownsCourse(cid) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.status == 'active' && 'purchased' in u && cid in u.purchased;
    }

    match /courseContent/{cid} {
      allow read: if isAdmin() || (request.auth != null && ownsCourse(cid));
      allow write: if isAdmin();
    }

    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ================= الإشعارات (جديد) =================
    // أي مستخدم مسجّل يقرأ الإشعارات، والأدمن بس هو اللي يكتب أو يحذف
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['title', 'body', 'type', 'target', 'link', 'at', 'by'])
                    && request.resource.data.title is string && request.resource.data.title.size() <= 80
                    && request.resource.data.body is string && request.resource.data.body.size() <= 300
                    && request.resource.data.type in ['lesson', 'exam', 'msg']
                    && request.resource.data.target in ['all', 'prep1', 'prep2', 'prep3', 'sec1', 'sec2'];
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ================= الامتحانات =================

    // الأسئلة (من غير الإجابات الصحيحة): قراءة لأي مستخدم مسجّل، كتابة للأدمن بس
    match /exams/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // الإجابات الصحيحة: الطالب مايقدر يقراها غير بعد ما يسلّم أول محاولة
    match /examKeys/{id} {
      allow read: if isAdmin()
                  || (request.auth != null
                      && exists(/databases/$(database)/documents/examSubs/$(request.auth.uid + '_' + id + '_1')));
      allow write: if isAdmin();
    }

    // تسليمات الطلبة
    match /examSubs/{sid} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'eid', 'n', 'ans', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.n is int
        && request.resource.data.n >= 1
        && sid == request.auth.uid + '_' + request.resource.data.eid + '_' + string(request.resource.data.n)
        && request.resource.data.n <= get(/databases/$(database)/documents/exams/$(request.resource.data.eid)).data.maxTry
        && (request.resource.data.n == 1
            || exists(/databases/$(database)/documents/examSubs/$(request.auth.uid + '_' + request.resource.data.eid + '_' + string(request.resource.data.n - 1))));

      // تصحيح الأسئلة المقالية: الأدمن بس
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}

